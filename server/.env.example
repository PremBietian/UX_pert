# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_SUBMISSIONS=5

# Optional Database (Falls back to local file storage if not provided)
MONGODB_URI=

# Optional Notification Email / SMTP (Simulated in logs if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
EMAIL_FROM="UXpert Agency" <notifications@uxpert.agency>
